    "/polymer": {
      "get": {
        "summary": "Query Polymer Engineering Specifications",
        "description": "Retrieve curated thermal, mechanical, chemical, and solvent properties for high-performance polymers (Zylon/PBO, Kevlar/PPTA, Kapton/PI, PVDF, PTFE, PEGDA, PEEK, Nafion).",
        "operationId": "get_polymer_specs_polymer_get",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Polymer name or acronym (e.g., 'zylon', 'pbo', 'kevlar', 'kapton', 'pvdf', 'nafion')",
              "title": "Name"
            },
            "description": "Polymer name or acronym (e.g., 'zylon', 'pbo', 'kevlar', 'kapton', 'pvdf', 'nafion')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Polymer Specs Polymer Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/coolprop": {
      "get": {
        "summary": "Calculate Thermophysical Properties via CoolProp EOS",
        "description": "Calculate density, dynamic viscosity, isobaric heat capacity Cp, thermal conductivity, enthalpy, entropy, and phase state for 120+ fluids across specified Temperature (K) and Pressure (Pa).",
        "operationId": "calculate_coolprop_coolprop_get",
        "parameters": [
          {
            "name": "fluid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Fluid name (e.g. 'Water', 'CO2', 'Ethanol', 'Methane', 'Nitrogen', 'Helium')",
              "title": "Fluid"
            },
            "description": "Fluid name (e.g. 'Water', 'CO2', 'Ethanol', 'Methane', 'Nitrogen', 'Helium')"
          },
          {
            "name": "temp_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Temperature in Kelvin (default: 298.15 K)",
              "default": 298.15,
              "title": "Temp K"
            },
            "description": "Temperature in Kelvin (default: 298.15 K)"
          },
          {
            "name": "pressure_pa",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Pressure in Pascals (default: 101325.0 Pa, 1 atm)",
              "default": 101325.0,
              "title": "Pressure Pa"
            },
            "description": "Pressure in Pascals (default: 101325.0 Pa, 1 atm)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Calculate Coolprop Coolprop Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/walden": {
      "get": {
        "summary": "Walden Plot & Ionicity Calculator",
        "description": "Calculate electrolyte molar conductivity, Walden product, deviation (Delta W), percentage ionicity, and ion-pairing dissociation regime (good ionic liquid, sub-ionic, poor).",
        "operationId": "calculate_walden_walden_get",
        "parameters": [
          {
            "name": "conductivity_ms_cm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Electrolyte ionic conductivity in mS/cm",
              "title": "Conductivity Ms Cm"
            },
            "description": "Electrolyte ionic conductivity in mS/cm"
          },
          {
            "name": "viscosity_mpa_s",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Dynamic viscosity in mPa.s (cP)",
              "title": "Viscosity Mpa S"
            },
            "description": "Dynamic viscosity in mPa.s (cP)"
          },
          {
            "name": "density_g_cm3",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional density in g/cm3 for molar conductivity",
              "title": "Density G Cm3"
            },
            "description": "Optional density in g/cm3 for molar conductivity"
          },
          {
            "name": "molar_mass",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional molar mass in g/mol",
              "title": "Molar Mass"
            },
            "description": "Optional molar mass in g/mol"
          },
          {
            "name": "temp_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Temperature in Kelvin (default: 298.15 K)",
              "default": 298.15,
              "title": "Temp K"
            },
            "description": "Temperature in Kelvin (default: 298.15 K)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Calculate Walden Walden Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/materials": {
      "get": {
        "summary": "Query Materials, Crystals, and DFT Databases",
        "description": "Query DFT formation energies, convex hull stability, elastic moduli, 2D monolayers, or MOF porosity from OQMD, AFLOW, C2DB, and MOFdb.",
        "operationId": "query_materials_materials_get",
        "parameters": [
          {
            "name": "formula",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Chemical formula (e.g., 'Fe2O3', 'MoS2', 'TiO2', 'UiO-66')",
              "title": "Formula"
            },
            "description": "Chemical formula (e.g., 'Fe2O3', 'MoS2', 'TiO2', 'UiO-66')"
          },
          {
            "name": "elements",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated constituent elements (e.g., 'Ti,O' or 'Fe,Ni')",
              "title": "Elements"
            },
            "description": "Comma-separated constituent elements (e.g., 'Ti,O' or 'Fe,Ni')"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Target database: 'oqmd', 'aflow', 'c2db', 'mofdb', or 'all'",
              "default": "oqmd",
              "title": "Source"
            },
            "description": "Target database: 'oqmd', 'aflow', 'c2db', 'mofdb', or 'all'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Query Materials Materials Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/substance": {
      "get": {
        "summary": "Query Chemical Substance, GHS Safety, and Kamlet-Taft Polarity",
        "description": "Retrieve PubChem physical properties, GHS hazard statements, Kamlet-Taft solvatochromic polarity (alpha, beta, pi*), and NIST WebBook thermochemistry.",
        "operationId": "query_substance_substance_get",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Chemical substance name or identifier (e.g., '[EMIM][TFSI]', 'benzene', 'NMP')",
              "title": "Name"
            },
            "description": "Chemical substance name or identifier (e.g., '[EMIM][TFSI]', 'benzene', 'NMP')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Query Substance Substance Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/literature": {
      "get": {
        "summary": "Multi-Source Academic Literature Discovery",
        "description": "Concurrently search 12 scholarly repositories (Semantic Scholar, Europe PMC, arXiv, OSTI, CORE, DOAJ, DataCite, PubMed, Zenodo, Scopus, OpenAlex, Crossref) with scite.ai consensus tallies and direct PDF links.",
        "operationId": "search_literature_literature_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Research search topic, compound, or keywords",
              "title": "Query"
            },
            "description": "Research search topic, compound, or keywords"
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of papers to return",
              "default": 50,
              "title": "Max Results"
            },
            "description": "Maximum number of papers to return"
          },
          {
            "name": "per_source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 30,
              "title": "Per Source"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "max_pages",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 10,
              "title": "Max Pages"
            }
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year From"
            }
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year To"
            }
          },
          {
            "name": "phrase",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "title": "Phrase"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "title": "Exclude"
            }
          },
          {
            "name": "synonyms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "title": "Synonyms"
            }
          },
          {
            "name": "sources",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sources"
            }
          },
          {
            "name": "enrich",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 8,
              "title": "Enrich"
            }
          },
          {
            "name": "require_all",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Require All"
            }
          },
          {
            "name": "min_relevance",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 0,
              "default": 1,
              "title": "Min Relevance"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Search Literature Literature Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/citation-graph": {
      "get": {
        "summary": "Explore Citation Graph (Connected Papers Snowballing)",
        "description": "Snowball literature around a seed paper DOI. Mode can be 'related' (co-citation / Connected Papers style), 'forward' (citing works), or 'backward' (seminal references).",
        "operationId": "get_citation_graph_citation_graph_get",
        "parameters": [
          {
            "name": "seed_doi",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Seed paper DOI (e.g. '10.1038/s41586-021-03819-2')",
              "title": "Seed Doi"
            },
            "description": "Seed paper DOI (e.g. '10.1038/s41586-021-03819-2')"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "'related', 'forward', or 'backward'",
              "default": "related",
              "title": "Mode"
            },
            "description": "'related', 'forward', or 'backward'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Citation Graph Citation Graph Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/deep-read": {
      "get": {
        "summary": "Retrieve and Deep-Read Full-Text PDF",
        "description": "Discover and retrieve public or campus-authorized paper PDF; return browser handoff when authentication is required. Parse PDF using PyMuPDF to extract experimental recipes, characterization parameters, and synthesis conditions.",
        "operationId": "deep_read_deep_read_get",
        "parameters": [
          {
            "name": "doi_or_url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Paper DOI or direct PDF URL",
              "title": "Doi Or Url"
            },
            "description": "Paper DOI or direct PDF URL"
          },
          {
            "name": "max_pages",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Pages"
            }
          },
          {
            "name": "ocr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Ocr"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Deep Read Deep Read Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/full-report": {
      "get": {
        "summary": "Generate Comprehensive ChemMat Hub Report",
        "description": "Query all databases concurrently (PubChem, OQMD, AFLOW, Polymer Specs, CoolProp, Kamlet-Taft, Literature) for a compound or material.",
        "operationId": "full_report_full_report_get",
        "parameters": [
          {
            "name": "compound",
            "in": "query",
            "required": true,
            "schema": {
